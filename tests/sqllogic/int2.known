# Where egres stands on each record of the .pgout beside this file:
# <tag>	<source>	<first line>	<note>, in record order.
#   skip      not supported yet; note = egres's error. Written by
#             run.py --write-skips, which keeps every other line.
#   bug       diverges, filed; note = the issue.
#   accepted  diverges on purpose; note = the reason.
skip	pg/test_setup.sql:65	VACUUM INT2_TBL	0A000 unsupported statement
skip	pg/int2.sql:21	SELECT pg_input_is_valid('34', 'int2')	0A000 function pg_input_is_valid() is not supported
skip	pg/int2.sql:22	SELECT pg_input_is_valid('asdf', 'int2')	0A000 function pg_input_is_valid() is not supported
skip	pg/int2.sql:23	SELECT pg_input_is_valid('50000', 'int2')	0A000 function pg_input_is_valid() is not supported
skip	pg/int2.sql:24	SELECT * FROM pg_input_error_info('50000', 'int2')	0A000 only table sources are supported
skip	pg/int2.sql:27	SELECT pg_input_is_valid(' 1 3 5 ', 'int2vector')	0A000 function pg_input_is_valid() is not supported
skip	pg/int2.sql:28	SELECT * FROM pg_input_error_info('1 asdf', 'int2vector')	0A000 only table sources are supported
skip	pg/int2.sql:29	SELECT * FROM pg_input_error_info('50000', 'int2vector')	0A000 only table sources are supported
bug	pg/int2.sql:31	SELECT * FROM INT2_TBL AS f(a, b)	a table alias's column list, AS f(a, b), is ignored
accepted	pg/int2.sql:65	SELECT i.f1, i.f1 * int2 '2' AS x FROM INT2_TBL i	arithmetic yields int8 whatever the operands' width; PG keeps the width and overflows
accepted	pg/int2.sql:72	SELECT i.f1, i.f1 + int2 '2' AS x FROM INT2_TBL i	arithmetic yields int8 whatever the operands' width; PG keeps the width and overflows
accepted	pg/int2.sql:79	SELECT i.f1, i.f1 - int2 '2' AS x FROM INT2_TBL i	arithmetic yields int8 whatever the operands' width; PG keeps the width and overflows
skip	pg/int2.sql:91	SELECT (-1::int2<<15)::text	0A000 only the + - * / % || operators are supported
skip	pg/int2.sql:92	SELECT ((-1::int2<<15)+1::int2)::text	0A000 only the + - * / % || operators are supported
accepted	pg/int2.sql:95	SELECT (-32768)::int2 * (-1)::int2	arithmetic yields int8 whatever the operands' width; PG keeps the width and overflows
accepted	pg/int2.sql:96	SELECT (-32768)::int2 / (-1)::int2	arithmetic yields int8 whatever the operands' width; PG keeps the width and overflows
skip	pg/int2.sql:100	SELECT x, x::int2 AS int2_value	0A000 only table sources are supported
skip	pg/int2.sql:110	SELECT x, x::int2 AS int2_value	0A000 only table sources are supported
accepted	pg/int2.sql:157	SELECT int2 '10__000'	egres accepts underscores in numeric input; Postgres rejects these
